MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=asset_control
MONGODB_TIMEOUT=10s

# Set to redis://localhost:6379/0 to enable protected inventory caching.
REDIS_URL=
REDIS_CACHE_TTL=1m

# Required: random signing secret of at least 32 bytes; never commit the value.
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=8h
# Use true with HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173
